<#-- Generated by npm run build from src/. Do not edit directly. -->
<#assign resetSent = message?has_content && message.type == 'success' && message.summary == msg('emailSentMessage')><#import "template.ftl" as layout>
<@layout.registrationLayout displayMessage=false; section><#if section = "icon"><#if resetSent><span class="auth-icon" aria-hidden="true"><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="1.75" y="3.25" width="12.5" height="9.5" rx="1.5"></rect><path d="m2.5 4.5 5.5 4 5.5-4"></path></svg></span></#if><#elseif section = "header"><#if resetSent>${msg("fwCheckEmail")}<#elseif messageHeader??>${kcSanitize(msg(messageHeader))?no_esc}<#else>${message.summary}</#if><#elseif section = "form"><div id="kc-info-message" class="auth-form"><p class="auth-sub"><#if resetSent>${msg("fwResetSent")}<#else>${kcSanitize(message.summary)?no_esc}<#if requiredActions??><#list requiredActions as action>: ${kcSanitize(msg("requiredAction." + action))?no_esc}<#sep>, </#list></#if></#if></p><#if !skipLink??><#if pageRedirectUri?has_content><a class="fw-btn fw-btn-primary fw-btn-lg fw-btn-block" href="${pageRedirectUri}">${msg("backToApplication")}</a><#elseif actionUri?has_content><a class="fw-btn fw-btn-primary fw-btn-lg fw-btn-block" href="${actionUri}">${msg("proceedWithAction")}</a><#elseif (client.baseUrl)?has_content><a class="fw-btn fw-btn-primary fw-btn-lg fw-btn-block" href="${client.baseUrl}">${msg("backToApplication")}</a></#if></#if><#if resetSent><a class="fw-btn fw-btn-ghost fw-btn-lg fw-btn-block" href="${url.loginUrl}">${msg("fwBackToSignIn")}</a></#if></div></#if></@layout.registrationLayout>
