<select data-locale-select aria-label="${msg('fwLanguage')}">
<#list locale.supported as l><option value="${l.url}" <#if l.label == locale.current>selected</#if>>${l.languageTag?upper_case}</option></#list>
</select>
<#else><span aria-label="${msg('fwLanguage')}">${lang?upper_case}</span></#if></label><main class="auth-main"><section class="auth-card" aria-labelledby="kc-page-title"><#nested "back"><header class="auth-hero"><#nested "icon"><h1 class="auth-title" id="kc-page-title"><#nested "header"></h1><#nested "subtitle"><#if displayRequiredFields><p class="fw-help">* ${msg("requiredFields")}</p></#if></header><#if displayMessage && message?has_content && (message.type != 'warning' || !isAppInitiatedAction??)><div role="${(message.type == 'error')?then('alert','status')}" class="fw-alert fw-alert-${message.type}" id="kc-feedback"><svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.25"></circle><path d="M8 4.75v3.75M8 10.75v.5"></path></svg><div class="fw-alert-body"><span class="fw-alert-text">${kcSanitize(message.summary)?no_esc}</span></div></div></#if><#nested "form"><#if auth?has_content && auth.showTryAnotherWayLink()><form id="kc-select-try-another-way-form" action="${url.loginAction}" method="post"><input type="hidden" name="tryAnotherWay" value="on"/><button type="submit" class="fw-btn fw-btn-link" id="try-another-way">${msg("doTryAnotherWay")}</button></form></#if><#if switchOrganizationEnabled?? && switchOrganizationEnabled><form action="${url.loginAction}" method="post"><input type="hidden" name="switchOrganization" value="true"/><button type="submit" class="fw-btn fw-btn-link">${msg("doSwitchOrganization")}</button></form></#if><#nested "socialProviders"><#if displayInfo><div id="kc-info" class="auth-bottom"><#nested "info"></div></#if></section></main></div></div></body></html></#macro>
